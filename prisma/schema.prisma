}

model Plan {
  id             Int            @id @default(autoincrement())
  name           String         @db.VarChar(50)
  slug           String         @unique @db.VarChar(50)
  // Price per billing cycle. `price` is the monthly rate and stays the canonical
  // one; the longer cycles are optional — a null means that cycle isn't offered.
  price            Int
  quarterlyPrice   Int?
  halfYearlyPrice  Int?
  yearlyPrice      Int?
  maxListings    Int
  maxPhotos      Int
  maxTenants     Int            @default(-1)
  features       Json
  // Super-admin controlled presentation + capability flags. These used to be
  // hardcoded in the owner upgrade page and in tier checks scattered across the
  // code; storing them here makes every plan fully admin-managed.
  tagline        String?        @db.VarChar(200) // short line under the plan name
  recommended    Boolean        @default(false)  // the "Recommended" highlight
  badge          String?        @db.VarChar(30)   // small corner badge, e.g. "Unlimited"
  sortOrder      Int            @default(0)        // display order across pricing/upgrade
  capabilities   Json           @default("{}")     // { csvExport, csvImport, adsFree, staff, leads, pgManager }
  // Partner commission: what a partner earns when an owner buys THIS plan.
  // type NONE = admin sets each earning by hand; PERCENT = % of the plan price;
  // FIXED = a flat ₹ amount. Admin-controlled from the Plans panel.
  partnerCommissionType  String @default("NONE") @db.VarChar(10)
  partnerCommissionValue Int    @default(0)
  /// How long a partner keeps earning on an owner they brought in, counted from
  /// the attribution date. 0 = forever (the original behaviour). Existing
  /// attributions are unaffected by a later change — see lib/partner-earnings.
  partnerCommissionMonths Int   @default(0)
  /// Two-sided referral: extra free days the REFERRED owner gets on this plan.
  /// 0 = the referral gives the new owner nothing.
  referralBonusDays      Int    @default(0)
  razorpayPlanId String?        @db.VarChar(100)
  isActive       Boolean        @default(true)
  subscriptions  Subscription[]

  @@map("plans")
}

model Subscription {
  id                Int          @id @default(autoincrement())
  userId            Int
  planId            Int
  status            SubStatus    @default(ACTIVE)
  billingCycle      BillingCycle @default(MONTHLY)
  amount            Int
  razorpaySubId     String?      @db.VarChar(100)
  razorpayOrderId   String?      @db.VarChar(100)
  // Unique: the checkout callback and the webhook can both fire for one payment.
  // This is what stops a race from creating two subscriptions — and two partner
  // commissions — for the same money. NULLs are exempt, so free plans are fine.
  razorpayPaymentId String?      @unique @db.VarChar(100)
  startDate         DateTime
  endDate           DateTime
  autoRenew         Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  invoices          Invoice[]
  plan              Plan         @relation(fields: [planId], references: [id])
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([endDate])
  @@map("subscriptions")
}

model Invoice {
  id              Int          @id @default(autoincrement())
  subscriptionId  Int
  amount          Int
  currency        String       @default("INR") @db.VarChar(5)
  status          String       @db.VarChar(20)
  razorpayOrderId String?      @db.VarChar(100)
  razorpayPayId   String?      @db.VarChar(100)
  invoiceDate     DateTime     @default(now())
  paidAt          DateTime?
  // Which billing cycle this payment covered, so a partner's history can read
  // "6 Month · ₹6,199" instead of a bare amount.
  billingCycle    BillingCycle @default(MONTHLY)
  periodStart     DateTime?
  periodEnd       DateTime?
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
  partnerEarning  PartnerEarning?

  @@index([subscriptionId])
  @@index([invoiceDate])
  @@map("invoices")
}

