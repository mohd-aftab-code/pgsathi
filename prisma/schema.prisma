generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════
// USERS
// ═══════════════════════════════════════
model User {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(cuid())
  name          String    @db.VarChar(100)
  email         String    @unique @db.VarChar(255)
  phone         String?   @unique @db.VarChar(15)
  passwordHash  String?   @db.Text
  role          UserRole  @default(TENANT)
  avatar        String?   @db.Text
  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)
  googleId      String?   @unique @db.VarChar(255)
  referralCode  String?   @unique @db.VarChar(20)
  referredBy    Int?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  listings      Listing[]
  subscriptions Subscription[]
  leads         Lead[]           @relation("TenantLeads")
  reviews       Review[]
  savedListings SavedListing[]
  beds          Bed[]            @relation("TenantBeds")
  visits        VisitBooking[]   @relation("TenantVisits")
  otpCodes      OtpCode[]

  // PG Manager relations
  pgTenantsOwned    PgTenant[]         @relation("PgTenantOwner")
  pgPaymentsOwned   PgPayment[]        @relation("PgPaymentOwner")
  pgRentBillsOwned  PgRentBill[]       @relation("PgRentBillOwner")
  pgMeterOwned      PgMeterReading[]   @relation("PgMeterOwner")
  pgComplaintsOwned PgComplaint[]      @relation("PgComplaintOwner")
  pgExpensesOwned   PgExpense[]        @relation("PgExpenseOwner")
  pgStaffOwned      PgStaff[]          @relation("PgStaffOwner")
  pgSalaryOwned     PgSalaryPayout[]   @relation("PgSalaryOwner")
  pgMessOwned       PgMessMenu[]       @relation("PgMessOwner")
  pgTeamOwned       PgTeamMember[]     @relation("PgTeamOwner")
  pgDocsOwned       PgTenantDocument[] @relation("PgDocOwner")
  pgAgreementsOwned PgAgreement[]      @relation("PgAgreementOwner")
  pgAuditOwned      PgAuditLog[]       @relation("PgAuditOwner")
  pgAnnouncements   PgAnnouncement[]   @relation("PgAnnouncementOwner")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@map("users")
}

enum UserRole {
  TENANT
  OWNER
  ADMIN
}

// ═══════════════════════════════════════
// CITIES & LOCALITIES
// ═══════════════════════════════════════
model City {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(100)
  slug       String     @unique @db.VarChar(120)
  state      String     @db.VarChar(100)
  isActive   Boolean    @default(true)
  priority   Int        @default(0)
  imageUrl   String?    @db.Text
  latitude   Decimal?   @db.Decimal(10, 8)
  longitude  Decimal?   @db.Decimal(11, 8)
  createdAt  DateTime   @default(now())

  localities Locality[]
  listings   Listing[]

  @@index([slug])
  @@index([isActive])
  @@map("cities")
}

model Locality {
  id        Int      @id @default(autoincrement())
  cityId    Int
  name      String   @db.VarChar(150)
  slug      String   @db.VarChar(180)
  isActive  Boolean  @default(true)
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  city      City     @relation(fields: [cityId], references: [id])
  listings  Listing[]

  @@unique([cityId, slug])
  @@index([cityId])
  @@map("localities")
}

// ═══════════════════════════════════════
// LISTINGS
// ═══════════════════════════════════════
model Listing {
  id              Int           @id @default(autoincrement())
  uuid            String        @unique @default(cuid())
  slug            String        @unique @db.VarChar(255)
  ownerId         Int
  cityId          Int
  localityId      Int?
  title           String        @db.VarChar(200)
  description     String        @db.Text
  pgType          PGType
  genderAllowed   GenderType
  address         String        @db.VarChar(500)
  landmark        String?       @db.VarChar(200)
  pincode         String        @db.VarChar(10)
  latitude        Decimal?      @db.Decimal(10, 8)
  longitude       Decimal?      @db.Decimal(11, 8)
  priceMin        Int
  priceMax        Int
  securityDeposit Int?
  electricityCharge Int?
  maintenanceCharge Int?
  foodCharge        Int?
  setupFee          Int?
  foodIncluded    Boolean       @default(false)
  totalRooms      Int?
  availableRooms  Int?
  totalBeds       Int?
  availableBeds   Int?
  noticePeriod    Boolean       @default(false)
  gateClosingTime Boolean       @default(false)
  rentLockIn      Boolean       @default(false)
  noGuardiansStay Boolean       @default(false)
  laundryService  Boolean       @default(false)
  roomCleaning    Boolean       @default(false)
  parking         Boolean       @default(false)
  status          ListingStatus @default(PENDING)
  isVerified      Boolean       @default(false)
  isFeatured      Boolean       @default(false)
  featuredUntil   DateTime?
  isActive        Boolean       @default(true)
  metaTitle       String?       @db.VarChar(160)
  metaDesc        String?       @db.VarChar(320)
  totalViews      Int           @default(0)
  totalLeads      Int           @default(0)
  totalReviews    Int           @default(0)
  avgRating       Decimal       @default(0) @db.Decimal(3, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  owner      User             @relation(fields: [ownerId], references: [id])
  city       City             @relation(fields: [cityId], references: [id])
  locality   Locality?        @relation(fields: [localityId], references: [id])
  photos     ListingPhoto[]
  amenities  ListingAmenity[]
  leads      Lead[]
  reviews    Review[]
  saved      SavedListing[]
  boosts     ListingBoost[]
  analytics  ListingAnalytic[]
  rooms      Room[]
  visits     VisitBooking[]

  // PG Manager relations
  pgTenants       PgTenant[]
  pgMeterReadings PgMeterReading[]
  pgComplaints    PgComplaint[]
  pgExpenses      PgExpense[]
  pgStaff         PgStaff[]
  pgMessMenus     PgMessMenu[]
  pgAnnouncements PgAnnouncement[]

  @@index([cityId, status, isActive])
  @@index([cityId, localityId, status])
  @@index([priceMin, priceMax])
  @@index([genderAllowed])
  @@index([isFeatured, featuredUntil])
  @@index([ownerId])
  @@index([slug])
  @@index([status, isVerified, isActive])
  @@map("listings")
}

enum PGType {
  SINGLE_ROOM
  DOUBLE_SHARING
  TRIPLE_SHARING
  DORMITORY
  STUDIO
  ENTIRE_FLAT
}

enum GenderType {
  BOYS
  GIRLS
  COED
}

enum ListingStatus {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
  EXPIRED
  DRAFT
}

// ═══════════════════════════════════════
// PHOTOS
// ═══════════════════════════════════════
model ListingPhoto {
  id        Int      @id @default(autoincrement())
  listingId Int
  url       String   @db.Text
  publicId  String   @db.VarChar(255)
  caption   String?  @db.VarChar(200)
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_photos")
}

// ═══════════════════════════════════════
// AMENITIES
// ═══════════════════════════════════════
model Amenity {
  id       Int              @id @default(autoincrement())
  name     String           @unique @db.VarChar(100)
  slug     String           @unique @db.VarChar(100)
  icon     String           @db.VarChar(50)
  category String           @db.VarChar(50)
  listings ListingAmenity[]

  @@map("amenities")
}

model ListingAmenity {
  listingId Int
  amenityId Int
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id])

  @@id([listingId, amenityId])
  @@index([listingId])
  @@map("listing_amenities")
}

// ═══════════════════════════════════════
// PLANS & SUBSCRIPTIONS
// ═══════════════════════════════════════
model Plan {
  id             Int            @id @default(autoincrement())
  name           String         @db.VarChar(50)
  slug           String         @unique @db.VarChar(50)
  price          Int
  yearlyPrice    Int?
  maxListings    Int
  maxPhotos      Int
  features       Json
  razorpayPlanId String?        @db.VarChar(100)
  isActive       Boolean        @default(true)
  subscriptions  Subscription[]

  @@map("plans")
}

model Subscription {
  id                Int          @id @default(autoincrement())
  userId            Int
  planId            Int
  status            SubStatus    @default(ACTIVE)
  billingCycle      BillingCycle @default(MONTHLY)
  amount            Int
  razorpaySubId     String?      @db.VarChar(100)
  razorpayOrderId   String?      @db.VarChar(100)
  razorpayPaymentId String?      @db.VarChar(100)
  startDate         DateTime
  endDate           DateTime
  autoRenew         Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([userId, status])
  @@index([endDate])
  @@map("subscriptions")
}

enum SubStatus {
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
  TRIAL
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

// ═══════════════════════════════════════
// INVOICES
// ═══════════════════════════════════════
model Invoice {
  id              Int          @id @default(autoincrement())
  subscriptionId  Int
  amount          Int
  currency        String       @default("INR") @db.VarChar(5)
  status          String       @db.VarChar(20)
  razorpayOrderId String?      @db.VarChar(100)
  razorpayPayId   String?      @db.VarChar(100)
  invoiceDate     DateTime     @default(now())
  paidAt          DateTime?

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@map("invoices")
}

// ═══════════════════════════════════════
// LISTING BOOSTS
// ═══════════════════════════════════════
model ListingBoost {
  id              Int       @id @default(autoincrement())
  listingId       Int
  boostType       BoostType
  amount          Int
  startDate       DateTime
  endDate         DateTime
  razorpayOrderId String?   @db.VarChar(100)
  razorpayPayId   String?   @db.VarChar(100)
  isPaid          Boolean   @default(false)
  createdAt       DateTime  @default(now())

  listing Listing @relation(fields: [listingId], references: [id])

  @@index([listingId, endDate])
  @@map("listing_boosts")
}

enum BoostType {
  SPOTLIGHT
  FEATURED
  HOMEPAGE
  WHATSAPP_BLAST
}

// ═══════════════════════════════════════
// LEADS
// ═══════════════════════════════════════
model Lead {
  id        Int        @id @default(autoincrement())
  listingId Int
  tenantId  Int?
  name      String     @db.VarChar(100)
  phone     String     @db.VarChar(15)
  email     String?    @db.VarChar(255)
  message   String?    @db.Text
  source    LeadSource @default(WEBSITE)
  isRead    Boolean    @default(false)
  createdAt DateTime   @default(now())

  listing Listing @relation(fields: [listingId], references: [id])
  tenant  User?   @relation("TenantLeads", fields: [tenantId], references: [id])

  @@index([listingId, createdAt])
  @@index([tenantId])
  @@map("leads")
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  PHONE
  APP
}

// ═══════════════════════════════════════
// REVIEWS
// ═══════════════════════════════════════
model Review {
  id         Int      @id @default(autoincrement())
  listingId  Int
  userId     Int
  rating     Int
  comment    String?  @db.Text
  isVerified Boolean  @default(false)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([listingId, userId])
  @@index([listingId, isApproved])
  @@map("reviews")
}

// ═══════════════════════════════════════
// SAVED LISTINGS
// ═══════════════════════════════════════
model SavedListing {
  userId    Int
  listingId Int
  savedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@map("saved_listings")
}

// ═══════════════════════════════════════
// ANALYTICS (daily)
// ═══════════════════════════════════════
model ListingAnalytic {
  id        Int      @id @default(autoincrement())
  listingId Int
  date      DateTime @db.Date
  views     Int      @default(0)
  leads     Int      @default(0)
  saves     Int      @default(0)
  whatsapps Int      @default(0)

  listing Listing @relation(fields: [listingId], references: [id])

  @@unique([listingId, date])
  @@index([listingId, date])
  @@map("listing_analytics")
}

// ═══════════════════════════════════════
// ROOMS & BEDS (OS LAYER)
// ═══════════════════════════════════════
model Room {
  id        Int      @id @default(autoincrement())
  listingId Int
  name      String   @db.VarChar(100)
  type      PGType
  floor     String?  @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing       Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  beds          Bed[]

  // PG Manager relations
  pgTenants       PgTenant[]
  pgMeterReadings PgMeterReading[]

  @@index([listingId])
  @@map("rooms")
}

model Bed {
  id        Int      @id @default(autoincrement())
  roomId    Int
  name      String   @db.VarChar(50)
  isOccupied Boolean @default(false)
  tenantId  Int?

  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenant    User?    @relation("TenantBeds", fields: [tenantId], references: [id])

  // PG Manager relations
  pgTenants PgTenant[]

  @@index([roomId])
  @@index([tenantId])
  @@map("beds")
}

// ═══════════════════════════════════════
// VISITS (TRUST LAYER)
// ═══════════════════════════════════════
model VisitBooking {
  id        Int      @id @default(autoincrement())
  listingId Int
  tenantId  Int?
  name      String   @db.VarChar(100)
  phone     String   @db.VarChar(15)
  visitDate DateTime
  status    VisitStatus @default(PENDING)
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tenant    User?    @relation("TenantVisits", fields: [tenantId], references: [id])

  @@index([listingId])
  @@index([visitDate])
  @@map("visit_bookings")
}

enum VisitStatus {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
}

// ═══════════════════════════════════════
// OTP CODES
// ═══════════════════════════════════════
model OtpCode {
  id        Int      @id @default(autoincrement())
  userId    Int?
  phone     String   @db.VarChar(15)
  code      String   @db.VarChar(6)
  purpose   String   @db.VarChar(20)
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([phone, expiresAt])
  @@map("otp_codes")
}

// ═══════════════════════════════════════
// PG MANAGER — TENANT (Actual paying guest,
// different from Lead. Owner records them manually.)
// ═══════════════════════════════════════
model PgTenant {
  id               Int       @id @default(autoincrement())
  ownerId          Int
  listingId        Int
  roomId           Int?
  bedId            Int?

  name             String    @db.VarChar(100)
  phone            String    @db.VarChar(15)
  email            String?   @db.VarChar(255)
  gender           String    @default("MALE") @db.VarChar(10)

  // KYC
  idType           String?   @db.VarChar(30)
  idNumber         String?   @db.VarChar(50)
  photoUrl         String?   @db.Text

  // Guardian
  guardianName     String?   @db.VarChar(100)
  guardianPhone    String?   @db.VarChar(15)
  permanentAddress String?   @db.Text

  // Stay & money
  monthlyRent      Int       @default(0)
  securityDeposit  Int       @default(0)
  rentDueDay       Int       @default(5)
  checkInDate      DateTime  @default(now())
  checkOutDate     DateTime?
  noticeDate       DateTime?
  expectedVacate   DateTime?
  status           String    @default("ACTIVE") @db.VarChar(20) // ACTIVE | NOTICE | VACATED
  depositRefunded  Int?
  notes            String?   @db.Text

  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner        User              @relation("PgTenantOwner", fields: [ownerId], references: [id])
  listing      Listing           @relation(fields: [listingId], references: [id])
  room         Room?             @relation(fields: [roomId], references: [id])
  bed          Bed?              @relation(fields: [bedId], references: [id])
  payments     PgPayment[]
  rentBills    PgRentBill[]
  documents    PgTenantDocument[]
  agreements   PgAgreement[]
  complaints   PgComplaint[]

  @@index([ownerId])
  @@index([listingId])
  @@index([status])
  @@map("pg_tenants")
}

// ═══════════════════════════════════════
// PG MANAGER — PAYMENT (Rent/deposit/misc recorded by owner)
// ═══════════════════════════════════════
model PgPayment {
  id          Int       @id @default(autoincrement())
  ownerId     Int
  tenantId    Int
  rentBillId  Int?

  amount      Int
  type        String    @default("RENT") @db.VarChar(30) // RENT | DEPOSIT | ELECTRICITY | LATE_FEE | OTHER
  forMonth    String?   @db.VarChar(7)                   // "2026-07"
  method      String    @default("CASH") @db.VarChar(20) // CASH | UPI | BANK | CHEQUE
  status      String    @default("PAID") @db.VarChar(20) // PAID | PARTIAL | PENDING
  paidOn      DateTime  @default(now())
  note        String?   @db.Text
  receiptNo   String?   @db.VarChar(30)
  voided      Boolean   @default(false)

  createdAt   DateTime  @default(now())

  owner    User       @relation("PgPaymentOwner", fields: [ownerId], references: [id])
  tenant   PgTenant   @relation(fields: [tenantId], references: [id])
  rentBill PgRentBill? @relation(fields: [rentBillId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([tenantId])
  @@index([forMonth])
  @@map("pg_payments")
}

// ═══════════════════════════════════════
// PG MANAGER — RENT BILL (Monthly invoice auto-generated)
// ═══════════════════════════════════════
model PgRentBill {
  id          Int       @id @default(autoincrement())
  ownerId     Int
  tenantId    Int

  forMonth    String    @db.VarChar(7) // "2026-07"
  rentAmount  Int
  electricity Int       @default(0)
  otherAmount Int       @default(0)
  lateFee     Int       @default(0)
  dueDate     DateTime
  billNo      String?   @db.VarChar(30)
  note        String?   @db.Text
  createdAt   DateTime  @default(now())

  owner    User       @relation("PgRentBillOwner", fields: [ownerId], references: [id])
  tenant   PgTenant   @relation(fields: [tenantId], references: [id])
  payments PgPayment[]

  @@unique([tenantId, forMonth])
  @@index([ownerId])
  @@map("pg_rent_bills")
}

// ═══════════════════════════════════════
// PG MANAGER — METER READING (Electricity per room)
// ═══════════════════════════════════════
model PgMeterReading {
  id          Int       @id @default(autoincrement())
  ownerId     Int
  listingId   Int
  roomId      Int

  forMonth    String    @db.VarChar(7)
  prevReading Int
  currReading Int
  ratePerUnit Int
  createdAt   DateTime  @default(now())

  owner   User    @relation("PgMeterOwner", fields: [ownerId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])
  room    Room    @relation(fields: [roomId], references: [id])

  @@unique([roomId, forMonth])
  @@index([ownerId])
  @@index([listingId])
  @@map("pg_meter_readings")
}

// ═══════════════════════════════════════
// PG MANAGER — COMPLAINT / MAINTENANCE
// ═══════════════════════════════════════
model PgComplaint {
  id          Int       @id @default(autoincrement())
  ownerId     Int
  listingId   Int
  tenantId    Int?

  title       String    @db.VarChar(200)
  description String?   @db.Text
  category    String    @default("OTHER") @db.VarChar(50) // PLUMBING | ELECTRICAL | CLEANING | OTHER
  priority    String    @default("MEDIUM") @db.VarChar(20) // LOW | MEDIUM | HIGH | URGENT
  status      String    @default("OPEN") @db.VarChar(20)   // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner   User      @relation("PgComplaintOwner", fields: [ownerId], references: [id])
  listing Listing   @relation(fields: [listingId], references: [id])
  tenant  PgTenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([listingId])
  @@index([status])
  @@map("pg_complaints")
}

// ═══════════════════════════════════════
// PG MANAGER — EXPENSE
// ═══════════════════════════════════════
model PgExpense {
  id          Int       @id @default(autoincrement())
  ownerId     Int
  listingId   Int?

  category    String    @default("OTHER") @db.VarChar(50) // MAINTENANCE | SALARY | GROCERY | UTILITY | OTHER
  amount      Int
  title       String    @db.VarChar(200)
  spentOn     DateTime  @default(now())
  note        String?   @db.Text
  createdAt   DateTime  @default(now())

  owner   User     @relation("PgExpenseOwner", fields: [ownerId], references: [id])
  listing Listing? @relation(fields: [listingId], references: [id])

  @@index([ownerId])
  @@index([listingId])
  @@map("pg_expenses")
}

// ═══════════════════════════════════════
// PG MANAGER — STAFF MEMBER
// ═══════════════════════════════════════
model PgStaff {
  id          Int       @id @default(autoincrement())
  ownerId     Int
  listingId   Int?

  name        String    @db.VarChar(100)
  role        String    @default("OTHER") @db.VarChar(50) // COOK | CLEANER | WARDEN | GUARD | OTHER
  phone       String?   @db.VarChar(15)
  salary      Int       @default(0)
  joinDate    DateTime  @default(now())
  active      Boolean   @default(true)
  note        String?   @db.Text
  createdAt   DateTime  @default(now())

  owner   User     @relation("PgStaffOwner", fields: [ownerId], references: [id])
  listing Listing? @relation(fields: [listingId], references: [id])
  payouts PgSalaryPayout[]

  @@index([ownerId])
  @@map("pg_staff")
}

// ═══════════════════════════════════════
// PG MANAGER — SALARY PAYOUT
// ═══════════════════════════════════════
model PgSalaryPayout {
  id        Int       @id @default(autoincrement())
  ownerId   Int
  staffId   Int

  forMonth  String    @db.VarChar(7)
  amount    Int
  paidOn    DateTime  @default(now())
  method    String    @default("CASH") @db.VarChar(20)
  note      String?   @db.Text

  owner User    @relation("PgSalaryOwner", fields: [ownerId], references: [id])
  staff PgStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, forMonth])
  @@index([ownerId])
  @@map("pg_salary_payouts")
}

// ═══════════════════════════════════════
// PG MANAGER — MESS MENU (Weekly per PG)
// ═══════════════════════════════════════
model PgMessMenu {
  id          Int       @id @default(autoincrement())
  ownerId     Int
  listingId   Int

  dayOfWeek   Int       // 0=Sun, 1=Mon ... 6=Sat
  breakfast   String?   @db.Text
  lunch       String?   @db.Text
  snacks      String?   @db.Text
  dinner      String?   @db.Text
  updatedAt   DateTime  @updatedAt

  owner   User    @relation("PgMessOwner", fields: [ownerId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])

  @@unique([listingId, dayOfWeek])
  @@index([ownerId])
  @@map("pg_mess_menus")
}

// ═══════════════════════════════════════
// PG MANAGER — TEAM MEMBER (Manager/Warden sub-login)
// ═══════════════════════════════════════
model PgTeamMember {
  id           Int       @id @default(autoincrement())
  ownerId      Int
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @db.Text
  role         String    @default("MANAGER") @db.VarChar(20) // MANAGER | WARDEN | ACCOUNTANT
  active       Boolean   @default(true)
  listingIds   String?   @db.Text // JSON array of listing IDs they can access ("[]" = all)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  owner User @relation("PgTeamOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
  @@map("pg_team_members")
}

// ═══════════════════════════════════════
// PG MANAGER — TENANT DOCUMENT (KYC)
// ═══════════════════════════════════════
model PgTenantDocument {
  id         Int       @id @default(autoincrement())
  ownerId    Int
  tenantId   Int

  type       String    @db.VarChar(40) // AADHAAR_FRONT | AADHAAR_BACK | PAN | PHOTO | POLICE_VERIFICATION | AGREEMENT | OTHER
  fileName   String    @db.VarChar(255)
  url        String    @db.Text
  publicId   String?   @db.VarChar(255)
  mimeType   String?   @db.VarChar(50)
  status     String    @default("PENDING") @db.VarChar(20) // PENDING | VERIFIED | REJECTED
  uploadedAt DateTime  @default(now())

  owner  User     @relation("PgDocOwner", fields: [ownerId], references: [id])
  tenant PgTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([ownerId])
  @@map("pg_tenant_documents")
}

// ═══════════════════════════════════════
// PG MANAGER — RENT AGREEMENT
// ═══════════════════════════════════════
model PgAgreement {
  id             Int       @id @default(autoincrement())
  ownerId        Int
  tenantId       Int

  startDate      DateTime
  endDate        DateTime?
  monthlyRent    Int
  deposit        Int
  noticeDays     Int       @default(30)
  terms          String?   @db.Text
  status         String    @default("DRAFT") @db.VarChar(20) // DRAFT | ACTIVE | EXPIRED
  signedDate     DateTime?
  createdAt      DateTime  @default(now())

  owner  User     @relation("PgAgreementOwner", fields: [ownerId], references: [id])
  tenant PgTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([ownerId])
  @@map("pg_agreements")
}

// ═══════════════════════════════════════
// PG MANAGER — AUDIT LOG
// ═══════════════════════════════════════
model PgAuditLog {
  id        Int       @id @default(autoincrement())
  ownerId   Int
  actor     String    @db.VarChar(150)
  action    String    @db.Text
  entity    String?   @db.VarChar(100)
  createdAt DateTime  @default(now())

  owner User @relation("PgAuditOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
  @@map("pg_audit_logs")
}

// ═══════════════════════════════════════
// PG MANAGER — ANNOUNCEMENT / NOTICE BOARD
// ═══════════════════════════════════════
model PgAnnouncement {
  id          Int       @id @default(autoincrement())
  ownerId     Int
  listingId   Int?

  title       String    @db.VarChar(200)
  message     String    @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  owner   User     @relation("PgAnnouncementOwner", fields: [ownerId], references: [id])
  listing Listing? @relation(fields: [listingId], references: [id])

  @@index([ownerId])
  @@map("pg_announcements")
}
