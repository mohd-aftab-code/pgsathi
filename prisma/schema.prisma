  tenant     PgTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([ownerId])
  @@map("pg_tenant_documents")
}

model PgAgreement {
  id          Int       @id @default(autoincrement())
  ownerId     Int
  tenantId    Int
  startDate   DateTime
  endDate     DateTime?
  monthlyRent Int
  deposit     Int
