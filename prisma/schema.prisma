generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                @id @default(autoincrement())
  uuid               String             @unique @default(cuid())
  name               String             @db.VarChar(100)
  email              String             @unique @db.VarChar(255)
  phone              String?            @unique @db.VarChar(15)
  passwordHash       String?
  role               UserRole           @default(TENANT)
  avatar             String?
  isVerified         Boolean            @default(false)
  isActive           Boolean            @default(true)
  googleId           String?            @unique @db.VarChar(255)
  referralCode       String?            @unique @db.VarChar(20)
  referredBy         Int?
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  languagePreference String             @default("ENGLISH") @db.VarChar(10)
  ownerType          String?            @db.VarChar(20)
  phoneVerified      Boolean            @default(false)
  whatsappNumber     String?            @db.VarChar(15)
  whatsappOptIn      Boolean            @default(false)
  whatsappVerified   Boolean            @default(false)
  messMenuEnabled    Boolean            @default(false)
  expensesEnabled    Boolean            @default(false)
  beds               Bed[]              @relation("TenantBeds")
  leads              Lead[]             @relation("TenantLeads")
  listings           Listing[]
  moderation_logs    moderation_logs[]
  otpCodes           OtpCode[]
  pgAgreementsOwned  PgAgreement[]      @relation("PgAgreementOwner")
  pgAnnouncements    PgAnnouncement[]   @relation("PgAnnouncementOwner")
  pgAuditOwned       PgAuditLog[]       @relation("PgAuditOwner")
  pgComplaintsOwned  PgComplaint[]      @relation("PgComplaintOwner")
  pgExpensesOwned    PgExpense[]        @relation("PgExpenseOwner")
  pgMessOwned        PgMessMenu[]       @relation("PgMessOwner")
  pgMeterOwned       PgMeterReading[]   @relation("PgMeterOwner")
  pgPaymentsOwned    PgPayment[]        @relation("PgPaymentOwner")
  pgRentBillsOwned   PgRentBill[]       @relation("PgRentBillOwner")
  pgSalaryOwned      PgSalaryPayout[]   @relation("PgSalaryOwner")
  pgStaffOwned       PgStaff[]          @relation("PgStaffOwner")
  pgTeamOwned        PgTeamMember[]     @relation("PgTeamOwner")
  pgDocsOwned        PgTenantDocument[] @relation("PgDocOwner")
  pgTenantsOwned     PgTenant[]         @relation("PgTenantOwner")
  tenantProfiles     PgTenant[]         @relation("TenantProfile")
  reviews            Review[]
  savedListings      SavedListing[]
  subscriptions      Subscription[]
  visits             VisitBooking[]     @relation("TenantVisits")
  notifications      Notification[]
  partnerProfile     PartnerProfile?    @relation("PartnerUser")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@map("users")
}

model City {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(100)
  slug       String     @unique @db.VarChar(120)
  state      String     @db.VarChar(100)
  isActive   Boolean    @default(true)
  priority   Int        @default(0)
  imageUrl   String?
  latitude   Decimal?   @db.Decimal(10, 8)
  longitude  Decimal?   @db.Decimal(11, 8)
  createdAt  DateTime   @default(now())
  metaDesc   String?    @db.VarChar(320)
  metaTitle  String?    @db.VarChar(160)
  listings   Listing[]
  localities Locality[]

  @@index([slug])
  @@index([isActive])
  @@map("cities")
}

model Locality {
  id        Int       @id @default(autoincrement())
  cityId    Int
  name      String    @db.VarChar(150)
  slug      String    @db.VarChar(180)
  isActive  Boolean   @default(true)
  latitude  Decimal?  @db.Decimal(10, 8)
  longitude Decimal?  @db.Decimal(11, 8)
  listings  Listing[]
  city      City      @relation(fields: [cityId], references: [id])

  @@unique([cityId, slug])
  @@index([cityId])
  @@map("localities")
}

model Listing {
  id                  Int                   @id @default(autoincrement())
  uuid                String                @unique @default(cuid())
  slug                String                @unique @db.VarChar(255)
  ownerId             Int
  cityId              Int?
  localityId          Int?
  title               String                @default("") @db.VarChar(200)
  description         String                @default("")
  genderAllowed       GenderType            @default(BOYS)
  address             String                @default("") @db.VarChar(500)
  landmark            String?               @db.VarChar(200)
  pincode             String                @default("") @db.VarChar(10)
  latitude            Decimal?              @db.Decimal(10, 8)
  longitude           Decimal?              @db.Decimal(11, 8)
  priceMin            Int                   @default(0)
  priceMax            Int                   @default(0)
  securityDeposit     Int?
  foodIncluded        Boolean               @default(false)
  totalRooms          Int?
  availableRooms      Int?
  totalBeds           Int?
  availableBeds       Int?
  status              ListingStatus         @default(DRAFT)
  isVerified          Boolean               @default(false)
  hasPendingChanges   Boolean               @default(false)
  reviewsEnabled      Boolean               @default(true)
  isFeatured          Boolean               @default(false)
  featuredUntil       DateTime?
  isActive            Boolean               @default(true)
  metaTitle           String?               @db.VarChar(160)
  metaDesc            String?               @db.VarChar(320)
  totalViews          Int                   @default(0)
  totalLeads          Int                   @default(0)
  totalReviews        Int                   @default(0)
  avgRating           Decimal               @default(0) @db.Decimal(3, 2)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  gateClosingTime     Boolean               @default(false)
  laundryService      Boolean               @default(false)
  noGuardiansStay     Boolean               @default(false)
  noticePeriod        Boolean               @default(false)
  parking             Boolean               @default(false)
  rentLockIn          Boolean               @default(false)
  roomCleaning        Boolean               @default(false)
  electricityCharge   Int?
  foodCharge          Int?
  maintenanceCharge   Int?
  setupFee            Int?
  alcoholAllowed      Boolean               @default(false)
  areaLocality        String?               @db.VarChar(200)
  // Partner attribution — set once when a partner registers the PG and never
  // changed. Nullable because PGs registered directly by owners have no partner.
  partnerId           Int?
  registeredVia       RegisteredVia         @default(SELF)
  buildingType        String?               @db.VarChar(20)
  cctvCoverage        String?               @db.VarChar(15)
  curfewTime          String?               @db.VarChar(10)
  depositRefundPolicy String?               @db.VarChar(30)
  doorNumber          String?               @db.VarChar(100)
  emergencyExits      Boolean               @default(false)
  fireExtinguisher    Boolean               @default(false)
  firstAidKit         Boolean               @default(false)
  foodAvailability    String?               @db.VarChar(20)
  foodType            String?               @db.VarChar(10)
  internetSpeed       String?               @db.VarChar(20)
  internetType        String?               @db.VarChar(15)
  isDraft             Boolean               @default(true)
  liftAvailable       Boolean               @default(false)
  lockInPeriodMonths  Int?
  moderationNotes     String?
  noticePeriodDays    Int?
  parkingType         String?               @db.VarChar(15)
  petsAllowed         Boolean               @default(false)
  pgFloors            String?
  powerBackup         String                @default("NONE") @db.VarChar(10)
  preferredGuest      String?               @db.VarChar(15)
  propertyAge         Int?
  propertyType        String                @default("PG") @db.VarChar(20)
  qualityScore        Int                   @default(0)
  rejectionReason     String?
  sector              String?               @db.VarChar(50)
  securityGuard       String?               @db.VarChar(10)
  seoScore            Int                   @default(0)
  smokingAllowed      Boolean               @default(false)
  state               String?               @db.VarChar(100)
  streetName          String?               @db.VarChar(200)
  totalFloors         Int?
  trustScore          Int                   @default(0)
  visitorsAllowed     String?               @db.VarChar(15)
  waterSupply         String?               @db.VarChar(15)
  wizardStep          Int                   @default(1)
  womenOnlyFloors     Boolean               @default(false)
  roomTypes           PGType[]              @default([SINGLE_ROOM])
  leads               Lead[]
  amenities           ListingAmenity[]
  analytics           ListingAnalytic[]
  boosts              ListingBoost[]
  photos              ListingPhoto[]
  city                City?                 @relation(fields: [cityId], references: [id])
  locality            Locality?             @relation(fields: [localityId], references: [id])
  owner               User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // SetNull: deleting a partner must never delete the PGs they brought in.
  partner             PartnerProfile?       @relation("ListingPartner", fields: [partnerId], references: [id], onDelete: SetNull)
  partnerEarnings     PartnerEarning[]
  moderation_logs     moderation_logs[]
  pgAnnouncements     PgAnnouncement[]
  pgComplaints        PgComplaint[]
  pgExpenses          PgExpense[]
  pgMessMenus         PgMessMenu[]
  pgMeterReadings     PgMeterReading[]
  pgStaff             PgStaff[]
  pgTenants           PgTenant[]
  property_pois       property_pois[]
  reviews             Review[]
  room_configurations room_configurations[]
  rooms               Room[]
  saved               SavedListing[]
  trust_records       trust_records?
  visits              VisitBooking[]

  @@index([cityId, status, isActive])
  @@index([cityId, localityId, status])
  @@index([priceMin, priceMax])
  @@index([genderAllowed])
  @@index([isFeatured, featuredUntil])
  @@index([ownerId])
  @@index([partnerId])
  @@index([slug])
  @@index([status, isVerified, isActive])
  @@index([isDraft, ownerId])
  @@index([qualityScore])
  @@map("listings")
}

model ListingPhoto {
  id         Int       @id @default(autoincrement())
  listingId  Int
  url        String
  publicId   String    @db.VarChar(255)
  caption    String?   @db.VarChar(200)
  sortOrder  Int       @default(0)
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  isVerified Boolean   @default(false)
  mediaType  String    @default("PHOTO") @db.VarChar(15)
  roomLabel  String?   @db.VarChar(30)
  verifiedAt DateTime?
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([listingId, mediaType])
  @@map("listing_photos")
}

model Amenity {
  id       Int              @id @default(autoincrement())
  name     String           @unique @db.VarChar(100)
  slug     String           @unique @db.VarChar(100)
  icon     String           @db.VarChar(50)
  category String           @db.VarChar(50)
  listings ListingAmenity[]

  @@map("amenities")
}

model ListingAmenity {
  listingId Int
  amenityId Int
  detail    String? @db.VarChar(100)
  amenity   Amenity @relation(fields: [amenityId], references: [id])
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([listingId, amenityId])
  @@index([listingId])
  @@map("listing_amenities")
}

// ═══════════════════════════════════════════════════════════════════════════
//  PARTNER PORTAL — Refer & Earn
//  A partner is a `User` with role PARTNER plus one profile row here. Every PG
//  they register stores `Listing.partnerId` permanently, and every partner
//  query MUST filter on it — that is the module's core isolation rule.
// ═══════════════════════════════════════════════════════════════════════════

model PartnerProfile {
  id            Int           @id @default(autoincrement())
  userId        Int           @unique
  partnerCode   String        @unique @db.VarChar(20) // shareable referral code
  type          PartnerType   @default(FREELANCER)
  status        PartnerStatus @default(PENDING) // self-signup starts PENDING
  company       String?       @db.VarChar(150)
  city          String?       @db.VarChar(100)
  address       String?       @db.VarChar(300)
  // Payout details — needed before a payout can be marked paid
  panNumber     String?       @db.VarChar(20)
  bankName      String?       @db.VarChar(120)
  bankAccountNo String?       @db.VarChar(30)
  bankIfsc      String?       @db.VarChar(15)
  upiId         String?       @db.VarChar(80)
  approvedAt    DateTime?
  approvedBy    Int?
  rejectReason  String?       @db.VarChar(300)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User                 @relation("PartnerUser", fields: [userId], references: [id], onDelete: Cascade)
  listings Listing[]            @relation("ListingPartner")
  earnings PartnerEarning[]
  payouts  PartnerPayout[]
  activity PartnerActivityLog[]
  settings PartnerSetting?

  @@index([status])
  @@map("partner_profiles")
}

model PartnerSetting {
  id             Int      @id @default(autoincrement())
  partnerId      Int      @unique
  notifyInApp    Boolean  @default(true)
  notifyEmail    Boolean  @default(true)
  notifyWhatsapp Boolean  @default(false)
  theme          String   @default("SYSTEM") @db.VarChar(10)
  language       String   @default("ENGLISH") @db.VarChar(10)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  partner PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("partner_settings")
}

/// One row per partner-registered PG that converted to a paid plan.
/// `amount` is set MANUALLY by the admin — there is deliberately no commission %.
model PartnerEarning {
  id             Int           @id @default(autoincrement())
  partnerId      Int
  listingId      Int
  subscriptionId Int? // which paid subscription triggered this
  amount         Int           @default(0) // ₹, admin-decided
  status         EarningStatus @default(PENDING)
  // Snapshots: the admin can change plan pricing later, so the earning must
  // remember what the conversion was actually based on.
  planNameSnapshot  String?    @db.VarChar(50)
  planPriceSnapshot Int?
  payoutId       Int?
  approvedAt     DateTime?
  approvedBy     Int?
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  partner PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  listing Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  payout  PartnerPayout? @relation(fields: [payoutId], references: [id])

  // Enforces the "one earning per PG" rule in the database itself, so a retry
  // or double-click can never create duplicate money.
  @@unique([partnerId, listingId])
  @@index([partnerId, status])
  @@index([listingId])
  @@index([createdAt])
  @@map("partner_earnings")
}

/// A batch payment to a partner; approved earnings are attached to it.
model PartnerPayout {
  id        Int          @id @default(autoincrement())
  partnerId Int
  amount    Int
  method    String       @default("UPI") @db.VarChar(20)
  reference String?      @db.VarChar(60) // UTR / txn ref
  status    PayoutStatus @default(PROCESSING)
  paidAt    DateTime?
  notes     String?
  createdBy Int?
  createdAt DateTime     @default(now())

  partner  PartnerProfile   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  earnings PartnerEarning[]

  @@index([partnerId, status])
  @@map("partner_payouts")
}

model PartnerActivityLog {
  id        Int      @id @default(autoincrement())
  partnerId Int
  action    String   @db.VarChar(160)
  entity    String?  @db.VarChar(60)
  entityId  Int?
  meta      Json?
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now())

  partner PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@map("partner_activity_logs")
}

/// Admin actions on money/partners, with before/after so every earning-amount
/// change is traceable. Kept separate from PgAuditLog, which is owner-scoped.
model AdminAuditLog {
  id        Int      @id @default(autoincrement())
  adminId   Int
  actor     String?  @db.VarChar(150)
  action    String   @db.VarChar(160)
  entity    String?  @db.VarChar(60)
  entityId  Int?
  before    Json?
  after     Json?
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([entity, entityId])
  @@map("admin_audit_logs")
}

/// Admin-togglable permission matrix. Code checks a permission key rather than
/// hardcoding a role, so access can be tightened without a deploy.
model RolePermission {
  id         Int      @id @default(autoincrement())
  role       String   @db.VarChar(20)
  permission String   @db.VarChar(60)
  allowed    Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@unique([role, permission])
  @@map("role_permissions")
}

model Plan {
  id             Int            @id @default(autoincrement())
  name           String         @db.VarChar(50)
  slug           String         @unique @db.VarChar(50)
  price          Int
  yearlyPrice    Int?
  maxListings    Int
  maxPhotos      Int
  maxTenants     Int            @default(-1)
  features       Json
  // Super-admin controlled presentation + capability flags. These used to be
  // hardcoded in the owner upgrade page and in tier checks scattered across the
  // code; storing them here makes every plan fully admin-managed.
  tagline        String?        @db.VarChar(200) // short line under the plan name
  recommended    Boolean        @default(false)  // the "Recommended" highlight
  badge          String?        @db.VarChar(30)   // small corner badge, e.g. "Unlimited"
  sortOrder      Int            @default(0)        // display order across pricing/upgrade
  capabilities   Json           @default("{}")     // { csvExport, csvImport, adsFree, staff, leads, pgManager }
  // Partner commission: what a partner earns when an owner buys THIS plan.
  // type NONE = admin sets each earning by hand; PERCENT = % of the plan price;
  // FIXED = a flat ₹ amount. Admin-controlled from the Plans panel.
  partnerCommissionType  String @default("NONE") @db.VarChar(10)
  partnerCommissionValue Int    @default(0)
  razorpayPlanId String?        @db.VarChar(100)
  isActive       Boolean        @default(true)
  subscriptions  Subscription[]

  @@map("plans")
}

model Subscription {
  id                Int          @id @default(autoincrement())
  userId            Int
  planId            Int
  status            SubStatus    @default(ACTIVE)
  billingCycle      BillingCycle @default(MONTHLY)
  amount            Int
  razorpaySubId     String?      @db.VarChar(100)
  razorpayOrderId   String?      @db.VarChar(100)
  razorpayPaymentId String?      @db.VarChar(100)
  startDate         DateTime
  endDate           DateTime
  autoRenew         Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  invoices          Invoice[]
  plan              Plan         @relation(fields: [planId], references: [id])
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([endDate])
  @@map("subscriptions")
}

model Invoice {
  id              Int          @id @default(autoincrement())
  subscriptionId  Int
  amount          Int
  currency        String       @default("INR") @db.VarChar(5)
  status          String       @db.VarChar(20)
  razorpayOrderId String?      @db.VarChar(100)
  razorpayPayId   String?      @db.VarChar(100)
  invoiceDate     DateTime     @default(now())
  paidAt          DateTime?
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@map("invoices")
}

model ListingBoost {
  id              Int       @id @default(autoincrement())
  listingId       Int
  boostType       BoostType
  amount          Int
  startDate       DateTime
  endDate         DateTime
  razorpayOrderId String?   @db.VarChar(100)
  razorpayPayId   String?   @db.VarChar(100)
  isPaid          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  listing         Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, endDate])
  @@map("listing_boosts")
}

model Lead {
  id        Int        @id @default(autoincrement())
  listingId Int
  tenantId  Int?
  name      String     @db.VarChar(100)
  phone     String     @db.VarChar(15)
  email     String?    @db.VarChar(255)
  message    String?
  source     LeadSource @default(WEBSITE)
  isRead     Boolean    @default(false)
  status     LeadStatus @default(NEW)
  followUpAt DateTime?
  notes      String?
  createdAt  DateTime   @default(now())
  listing    Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tenant     User?      @relation("TenantLeads", fields: [tenantId], references: [id])

  @@index([listingId, createdAt])
  @@index([listingId, status])
  @@index([tenantId])
  @@map("leads")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType @default(SYSTEM)
  title     String           @db.VarChar(180)
  message   String?
  link      String?          @db.VarChar(255)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Review {
  id         Int      @id @default(autoincrement())
  listingId  Int
  userId     Int
  rating     Int
  comment    String?
  isVerified Boolean  @default(false)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@index([listingId, isApproved])
  @@map("reviews")
}

model SavedListing {
  userId    Int
  listingId Int
  savedAt   DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@map("saved_listings")
}

model ListingAnalytic {
  id        Int      @id @default(autoincrement())
  listingId Int
  date      DateTime @db.Date
  views     Int      @default(0)
  leads     Int      @default(0)
  saves     Int      @default(0)
  whatsapps Int      @default(0)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([listingId, date])
  @@map("listing_analytics")
}

model Room {
  id              Int              @id @default(autoincrement())
  listingId       Int
  name            String           @db.VarChar(100)
  type            PGType
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  floor           String?          @db.VarChar(50)
  price           Int              @default(0)
  beds            Bed[]
  pgMeterReadings PgMeterReading[]
  pgTenants       PgTenant[]
  listing         Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("rooms")
}

model Bed {
  id         Int        @id @default(autoincrement())
  roomId     Int
  name       String     @db.VarChar(50)
  isOccupied Boolean    @default(false)
  tenantId   Int?
  room       Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenant     User?      @relation("TenantBeds", fields: [tenantId], references: [id])
  pgTenants  PgTenant[]

  @@index([roomId])
  @@index([tenantId])
  @@map("beds")
}

model VisitBooking {
  id        Int         @id @default(autoincrement())
  listingId Int
  tenantId  Int?
  name      String      @db.VarChar(100)
  phone     String      @db.VarChar(15)
  visitDate DateTime
  status    VisitStatus @default(PENDING)
  createdAt DateTime    @default(now())
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tenant    User?       @relation("TenantVisits", fields: [tenantId], references: [id])

  @@index([listingId])
  @@index([visitDate])
  @@map("visit_bookings")
}

model OtpCode {
  id          Int      @id @default(autoincrement())
  userId      Int?
  phone       String?  @db.VarChar(15)
  code        String   @db.VarChar(6)
  purpose     String   @db.VarChar(20)
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  createdAt   DateTime @default(now())
  email       String?  @db.VarChar(255)
  accountType String?  @db.VarChar(10)
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, expiresAt])
  @@index([email, expiresAt])
  @@map("otp_codes")
}

model PgTenant {
  id               Int                @id @default(autoincrement())
  ownerId          Int
  listingId        Int
  roomId           Int?
  bedId            Int?
  name             String             @db.VarChar(100)
  phone            String             @db.VarChar(15)
  email            String?            @db.VarChar(255)
  gender           String             @default("MALE") @db.VarChar(10)
  idType           String?            @db.VarChar(30)
  idNumber         String?            @db.VarChar(50)
  photoUrl         String?
  guardianName     String?            @db.VarChar(100)
  guardianPhone    String?            @db.VarChar(15)
  permanentAddress String?
  monthlyRent      Int                @default(0)
  securityDeposit  Int                @default(0)
  rentDueDay       Int                @default(5)
  checkInDate      DateTime           @default(now())
  checkOutDate     DateTime?
  noticeDate       DateTime?
  expectedVacate   DateTime?
  status           String             @default("ACTIVE") @db.VarChar(20)
  depositRefunded  Int?
  notes            String?
  deletedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  userId           Int?
  agreements       PgAgreement[]
  complaints       PgComplaint[]
  payments         PgPayment[]
  rentBills        PgRentBill[]
  documents        PgTenantDocument[]
  bed              Bed?               @relation(fields: [bedId], references: [id])
  listing          Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  owner            User               @relation("PgTenantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  room             Room?              @relation(fields: [roomId], references: [id])
  user             User?              @relation("TenantProfile", fields: [userId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([userId])
  @@index([listingId])
  @@index([status])
  @@map("pg_tenants")
}

model PgPayment {
  id         Int         @id @default(autoincrement())
  ownerId    Int
  tenantId   Int
  rentBillId Int?
  amount     Int
  type       String      @default("RENT") @db.VarChar(30)
  forMonth   String?     @db.VarChar(7)
  method     String      @default("CASH") @db.VarChar(20)
  status     String      @default("PAID") @db.VarChar(20)
  paidOn     DateTime    @default(now())
  note       String?
  receiptNo  String?     @db.VarChar(30)
  voided     Boolean     @default(false)
  createdAt  DateTime    @default(now())
  owner      User        @relation("PgPaymentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  rentBill   PgRentBill? @relation(fields: [rentBillId], references: [id])
  tenant     PgTenant    @relation(fields: [tenantId], references: [id])

  @@index([ownerId])
  @@index([tenantId])
  @@index([forMonth])
  @@map("pg_payments")
}

model PgRentBill {
  id          Int         @id @default(autoincrement())
  ownerId     Int
  tenantId    Int
  forMonth    String      @db.VarChar(7)
  rentAmount  Int
  electricity Int         @default(0)
  otherAmount Int         @default(0)
  lateFee     Int         @default(0)
  dueDate     DateTime
  billNo      String?     @db.VarChar(30)
  note        String?
  createdAt   DateTime    @default(now())
  payments    PgPayment[]
  owner       User        @relation("PgRentBillOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  tenant      PgTenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, forMonth])
  @@index([ownerId])
  @@map("pg_rent_bills")
}

model PgMeterReading {
  id          Int      @id @default(autoincrement())
  ownerId     Int
  listingId   Int
  roomId      Int
  forMonth    String   @db.VarChar(7)
  prevReading Int
  currReading Int
  ratePerUnit Int
  createdAt   DateTime @default(now())
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  owner       User     @relation("PgMeterOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  room        Room     @relation(fields: [roomId], references: [id])

  @@unique([roomId, forMonth])
  @@index([ownerId])
  @@index([listingId])
  @@map("pg_meter_readings")
}

model PgComplaint {
  id          Int       @id @default(autoincrement())
  ownerId     Int
  listingId   Int
  tenantId    Int?
  title       String    @db.VarChar(200)
  description String?
  category    String    @default("OTHER") @db.VarChar(50)
  priority    String    @default("MEDIUM") @db.VarChar(20)
  status      String    @default("OPEN") @db.VarChar(20)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  owner       User      @relation("PgComplaintOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  tenant      PgTenant? @relation(fields: [tenantId], references: [id])

  @@index([ownerId])
  @@index([listingId])
  @@index([status])
  @@map("pg_complaints")
}

model PgExpense {
  id        Int      @id @default(autoincrement())
  ownerId   Int
  listingId Int?
  category  String   @default("OTHER") @db.VarChar(50)
  amount    Int
  title     String   @db.VarChar(200)
  spentOn   DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  owner     User     @relation("PgExpenseOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([listingId])
  @@map("pg_expenses")
}

model PgStaff {
  id        Int              @id @default(autoincrement())
  ownerId   Int
  listingId Int?
  name      String           @db.VarChar(100)
  role      String           @default("OTHER") @db.VarChar(50)
  phone     String?          @db.VarChar(15)
  salary    Int              @default(0)
  joinDate  DateTime         @default(now())
  active    Boolean          @default(true)
  note      String?
  createdAt DateTime         @default(now())
  payouts   PgSalaryPayout[]
  listing   Listing?         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  owner     User             @relation("PgStaffOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("pg_staff")
}

model PgSalaryPayout {
  id       Int      @id @default(autoincrement())
  ownerId  Int
  staffId  Int
  forMonth String   @db.VarChar(7)
  amount   Int
  paidOn   DateTime @default(now())
  method   String   @default("CASH") @db.VarChar(20)
  note     String?
  owner    User     @relation("PgSalaryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  staff    PgStaff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, forMonth])
  @@index([ownerId])
  @@map("pg_salary_payouts")
}

model PgMessMenu {
  id        Int      @id @default(autoincrement())
  ownerId   Int
  listingId Int
  dayOfWeek Int
  breakfast String?
  lunch     String?
  snacks    String?
  dinner    String?
  updatedAt DateTime @updatedAt
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  owner     User     @relation("PgMessOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([listingId, dayOfWeek])
  @@index([ownerId])
  @@map("pg_mess_menus")
}

model PgTeamMember {
  id           Int      @id @default(autoincrement())
  ownerId      Int
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String
  role         String   @default("MANAGER") @db.VarChar(20)
  active       Boolean  @default(true)
  listingIds   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  owner        User     @relation("PgTeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("pg_team_members")
}

model PgTenantDocument {
  id         Int      @id @default(autoincrement())
