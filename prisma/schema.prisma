generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                @id @default(autoincrement())
  uuid               String             @unique @default(cuid())
  name               String             @db.VarChar(100)
  email              String             @unique @db.VarChar(255)
  phone              String?            @unique @db.VarChar(15)
  passwordHash       String?
  role               UserRole           @default(TENANT)
  avatar             String?
  isVerified         Boolean            @default(false)
  isActive           Boolean            @default(true)
  googleId           String?            @unique @db.VarChar(255)
  // Owner-to-owner referral. `referralCode` is this user's own shareable code
  // (generated for owners on demand); `referredBy` is the user whose code
  // brought them in. Partner referrals use `partnerId` below instead — the two
  // are deliberately separate ledgers.
  referralCode       String?            @unique @db.VarChar(20)
  referredBy         Int?
  /// Set when the referral reward (extra trial days) was actually granted, so
  /// it can never be granted twice.
  referralRewardAt   DateTime?
  /// A partner-created account hands the password to the partner. Forcing a
  /// change on first login is what stops the partner keeping that access.
  mustChangePassword Boolean            @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  languagePreference String             @default("ENGLISH") @db.VarChar(10)
  ownerType          String?            @db.VarChar(20)
  phoneVerified      Boolean            @default(false)
  whatsappNumber     String?            @db.VarChar(15)
  whatsappOptIn      Boolean            @default(false)
  whatsappVerified   Boolean            @default(false)
  messMenuEnabled    Boolean            @default(false)
  expensesEnabled    Boolean            @default(false)
  // Which partner brought this user in. Set on the FIRST partner touch (creating
  // the account, or registering their first PG) and never changed afterwards —
  // a stable attribution is what keeps payouts unambiguous when an owner ends up
  // with PGs from more than one partner. Null for self-registered users.
  partnerId          Int?
  /// When the partner attribution was stamped. A plan can cap how long a
  /// partner keeps earning on an owner, and that clock starts here.
  partnerAttributedAt DateTime?
  beds               Bed[]              @relation("TenantBeds")
  leads              Lead[]             @relation("TenantLeads")
  listings           Listing[]
  moderation_logs    moderation_logs[]
  otpCodes           OtpCode[]
  pgAgreementsOwned  PgAgreement[]      @relation("PgAgreementOwner")
  pgAnnouncements    PgAnnouncement[]   @relation("PgAnnouncementOwner")
  pgAuditOwned       PgAuditLog[]       @relation("PgAuditOwner")
  pgComplaintsOwned  PgComplaint[]      @relation("PgComplaintOwner")
  pgExpensesOwned    PgExpense[]        @relation("PgExpenseOwner")
  pgMessOwned        PgMessMenu[]       @relation("PgMessOwner")
  pgMeterOwned       PgMeterReading[]   @relation("PgMeterOwner")
  pgPaymentsOwned    PgPayment[]        @relation("PgPaymentOwner")
  pgRentBillsOwned   PgRentBill[]       @relation("PgRentBillOwner")
  pgSalaryOwned      PgSalaryPayout[]   @relation("PgSalaryOwner")
  pgStaffOwned       PgStaff[]          @relation("PgStaffOwner")
  pgTeamOwned        PgTeamMember[]     @relation("PgTeamOwner")
  pgDocsOwned        PgTenantDocument[] @relation("PgDocOwner")
  pgTenantsOwned     PgTenant[]         @relation("PgTenantOwner")
  tenantProfiles     PgTenant[]         @relation("TenantProfile")
  reviews            Review[]
  savedListings      SavedListing[]
  subscriptions      Subscription[]
  visits             VisitBooking[]     @relation("TenantVisits")
  notifications      Notification[]
  partnerProfile     PartnerProfile?    @relation("PartnerUser")
  // SetNull: removing a partner must never delete the owners they brought in.
  partner            PartnerProfile?    @relation("PartnerOwners", fields: [partnerId], references: [id], onDelete: SetNull)
  partnerEarnings    PartnerEarning[]   @relation("EarningOwner")
  // SetNull for the same reason as partner: losing a referrer must not delete
  // the accounts they referred.
  referrer           User?              @relation("UserReferrals", fields: [referredBy], references: [id], onDelete: SetNull)
  referrals          User[]             @relation("UserReferrals")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([referredBy])
  @@map("users")
}

model City {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(100)
  slug       String     @unique @db.VarChar(120)
  state      String     @db.VarChar(100)
  isActive   Boolean    @default(true)
  priority   Int        @default(0)
  imageUrl   String?
  latitude   Decimal?   @db.Decimal(10, 8)
  longitude  Decimal?   @db.Decimal(11, 8)
  createdAt  DateTime   @default(now())
  metaDesc   String?    @db.VarChar(320)
  metaTitle  String?    @db.VarChar(160)
  listings   Listing[]
  localities Locality[]

  @@index([slug])
  @@index([isActive])
  @@map("cities")
}

model Locality {
  id        Int       @id @default(autoincrement())
  cityId    Int
  name      String    @db.VarChar(150)
  slug      String    @db.VarChar(180)
  isActive  Boolean   @default(true)
  latitude  Decimal?  @db.Decimal(10, 8)
  longitude Decimal?  @db.Decimal(11, 8)
  listings  Listing[]
  city      City      @relation(fields: [cityId], references: [id])

  @@unique([cityId, slug])
  @@index([cityId])
  @@map("localities")
}

model Listing {
  id                  Int                   @id @default(autoincrement())
  uuid                String                @unique @default(cuid())
  slug                String                @unique @db.VarChar(255)
  ownerId             Int
  cityId              Int?
  localityId          Int?
  title               String                @default("") @db.VarChar(200)
  description         String                @default("")
  genderAllowed       GenderType            @default(BOYS)
  address             String                @default("") @db.VarChar(500)
  landmark            String?               @db.VarChar(200)
  pincode             String                @default("") @db.VarChar(10)
  latitude            Decimal?              @db.Decimal(10, 8)
  longitude           Decimal?              @db.Decimal(11, 8)
  priceMin            Int                   @default(0)
  priceMax            Int                   @default(0)
  securityDeposit     Int?
  foodIncluded        Boolean               @default(false)
  totalRooms          Int?
  availableRooms      Int?
  totalBeds           Int?
  availableBeds       Int?
  status              ListingStatus         @default(DRAFT)
  isVerified          Boolean               @default(false)
  hasPendingChanges   Boolean               @default(false)
  reviewsEnabled      Boolean               @default(true)
  isFeatured          Boolean               @default(false)
  featuredUntil       DateTime?
  isActive            Boolean               @default(true)
  metaTitle           String?               @db.VarChar(160)
  metaDesc            String?               @db.VarChar(320)
  totalViews          Int                   @default(0)
  totalLeads          Int                   @default(0)
  totalReviews        Int                   @default(0)
  avgRating           Decimal               @default(0) @db.Decimal(3, 2)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  gateClosingTime     Boolean               @default(false)
  laundryService      Boolean               @default(false)
  noGuardiansStay     Boolean               @default(false)
  noticePeriod        Boolean               @default(false)
  parking             Boolean               @default(false)
  rentLockIn          Boolean               @default(false)
  roomCleaning        Boolean               @default(false)
  electricityCharge   Int?
  foodCharge          Int?
  maintenanceCharge   Int?
  setupFee            Int?
  alcoholAllowed      Boolean               @default(false)
  areaLocality        String?               @db.VarChar(200)
  // Partner attribution — set once when a partner registers the PG and never
  // changed. Nullable because PGs registered directly by owners have no partner.
  partnerId           Int?
  registeredVia       RegisteredVia         @default(SELF)
  buildingType        String?               @db.VarChar(20)
  cctvCoverage        String?               @db.VarChar(15)
  curfewTime          String?               @db.VarChar(10)
  depositRefundPolicy String?               @db.VarChar(30)
  doorNumber          String?               @db.VarChar(100)
  emergencyExits      Boolean               @default(false)
  fireExtinguisher    Boolean               @default(false)
  firstAidKit         Boolean               @default(false)
  foodAvailability    String?               @db.VarChar(20)
  foodType            String?               @db.VarChar(10)
  internetSpeed       String?               @db.VarChar(20)
  internetType        String?               @db.VarChar(15)
  isDraft             Boolean               @default(true)
  liftAvailable       Boolean               @default(false)
  lockInPeriodMonths  Int?
  moderationNotes     String?
  noticePeriodDays    Int?
  parkingType         String?               @db.VarChar(15)
  petsAllowed         Boolean               @default(false)
  pgFloors            String?
  powerBackup         String                @default("NONE") @db.VarChar(10)
  preferredGuest      String?               @db.VarChar(15)
  propertyAge         Int?
  propertyType        String                @default("PG") @db.VarChar(20)
  qualityScore        Int                   @default(0)
  rejectionReason     String?
  sector              String?               @db.VarChar(50)
  securityGuard       String?               @db.VarChar(10)
  seoScore            Int                   @default(0)
  smokingAllowed      Boolean               @default(false)
  state               String?               @db.VarChar(100)
  streetName          String?               @db.VarChar(200)
  totalFloors         Int?
  trustScore          Int                   @default(0)
  visitorsAllowed     String?               @db.VarChar(15)
  waterSupply         String?               @db.VarChar(15)
  wizardStep          Int                   @default(1)
  womenOnlyFloors     Boolean               @default(false)
  roomTypes           PGType[]              @default([SINGLE_ROOM])
  leads               Lead[]
  amenities           ListingAmenity[]
  analytics           ListingAnalytic[]
  boosts              ListingBoost[]
  photos              ListingPhoto[]
  city                City?                 @relation(fields: [cityId], references: [id])
  locality            Locality?             @relation(fields: [localityId], references: [id])
  owner               User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // SetNull: deleting a partner must never delete the PGs they brought in.
  partner             PartnerProfile?       @relation("ListingPartner", fields: [partnerId], references: [id], onDelete: SetNull)
  partnerEarnings     PartnerEarning[]
  moderation_logs     moderation_logs[]
  pgAnnouncements     PgAnnouncement[]
  pgComplaints        PgComplaint[]
  pgExpenses          PgExpense[]
  pgMessMenus         PgMessMenu[]
  pgMeterReadings     PgMeterReading[]
  pgStaff             PgStaff[]
  pgTenants           PgTenant[]
  property_pois       property_pois[]
  reviews             Review[]
  room_configurations room_configurations[]
  rooms               Room[]
  saved               SavedListing[]
  trust_records       trust_records?
  visits              VisitBooking[]

  @@index([cityId, status, isActive])
  @@index([cityId, localityId, status])
  @@index([priceMin, priceMax])
  @@index([genderAllowed])
  @@index([isFeatured, featuredUntil])
  @@index([ownerId])
  @@index([partnerId])
  @@index([slug])
  @@index([status, isVerified, isActive])
  @@index([isDraft, ownerId])
  @@index([qualityScore])
  // City browse pages filter on both together; [status, …] alone can't serve it.
  @@index([cityId, status])
  @@map("listings")
}

model ListingPhoto {
  id         Int       @id @default(autoincrement())
  listingId  Int
  url        String
  publicId   String    @db.VarChar(255)
  caption    String?   @db.VarChar(200)
  sortOrder  Int       @default(0)
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  isVerified Boolean   @default(false)
  mediaType  String    @default("PHOTO") @db.VarChar(15)
  roomLabel  String?   @db.VarChar(30)
  verifiedAt DateTime?
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([listingId, mediaType])
  @@map("listing_photos")
}

model Amenity {
  id       Int              @id @default(autoincrement())
  name     String           @unique @db.VarChar(100)
  slug     String           @unique @db.VarChar(100)
  icon     String           @db.VarChar(50)
  category String           @db.VarChar(50)
  listings ListingAmenity[]

  @@map("amenities")
}

model ListingAmenity {
  listingId Int
  amenityId Int
  detail    String? @db.VarChar(100)
  amenity   Amenity @relation(fields: [amenityId], references: [id])
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([listingId, amenityId])
  @@index([listingId])
  @@map("listing_amenities")
}

// ═══════════════════════════════════════════════════════════════════════════
//  PARTNER PORTAL — Refer & Earn
//  A partner is a `User` with role PARTNER plus one profile row here. Every PG
//  they register stores `Listing.partnerId` permanently, and every partner
//  query MUST filter on it — that is the module's core isolation rule.
// ═══════════════════════════════════════════════════════════════════════════

model PartnerProfile {
  id            Int           @id @default(autoincrement())
  userId        Int           @unique
  partnerCode   String        @unique @db.VarChar(20) // shareable referral code
  type          PartnerType   @default(FREELANCER)
  status        PartnerStatus @default(PENDING) // self-signup starts PENDING
  company       String?       @db.VarChar(150)
  city          String?       @db.VarChar(100)
  address       String?       @db.VarChar(300)
  // Payout details — needed before a payout can be marked paid
  panNumber     String?       @db.VarChar(20)
  bankName      String?       @db.VarChar(120)
  bankAccountNo String?       @db.VarChar(30)
  bankIfsc      String?       @db.VarChar(15)
  upiId         String?       @db.VarChar(80)
  approvedAt    DateTime?
  approvedBy    Int?
  rejectReason  String?       @db.VarChar(300)
  notes         String?
  // Payout details are only trustworthy once an admin has eyeballed them. A
  // payout cannot be created until this is set — see api/admin/partner-payouts.
  kycVerifiedAt DateTime?
  kycVerifiedBy Int?
  // Fraud controls. A flagged partner keeps earning (the referral may be real)
  // but every earning of theirs lands on hold instead of auto-approving.
  riskFlagged   Boolean       @default(false)
  riskReason    String?       @db.VarChar(300)
  // Soft delete. Partners are never hard-deleted — that would orphan the
  // historical "who brought this owner in" link that earnings are audited on.
  archivedAt    DateTime?
  // ── Commission controls ───────────────────────────────────────────────────
  // When set, this rate replaces the plan's rate entirely — the custom deal a
  // big channel partner negotiates. Percent of the invoice.
  commissionOverridePercent Int?
  // Tier is normally derived from paid conversions; an admin can pin it.
  tierOverride              String?  @db.VarChar(12)
  // Sub-partner hierarchy: this partner works under `parent`, and the parent
  // earns `parentOverridePercent`% of whatever this partner earns.
  parentPartnerId           Int?
  parentOverridePercent     Int      @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User                 @relation("PartnerUser", fields: [userId], references: [id], onDelete: Cascade)
  listings Listing[]            @relation("ListingPartner")
  // SetNull: removing a parent must never cascade into their sub-partners.
  parent   PartnerProfile?      @relation("PartnerHierarchy", fields: [parentPartnerId], references: [id], onDelete: SetNull)
  children PartnerProfile[]     @relation("PartnerHierarchy")
  clicks   ReferralClick[]
  leads    PartnerLead[]
  // Owners this partner brought in. Commission follows the OWNER (one payment =
  // one commission, whatever their PG count), so this — not `listings` — is what
  // earnings are calculated from.
  owners   User[]               @relation("PartnerOwners")
  earnings PartnerEarning[]
  payouts  PartnerPayout[]
  activity PartnerActivityLog[]
  settings PartnerSetting?

  @@index([status])
  @@index([parentPartnerId])
  @@map("partner_profiles")
}

/// Single-row config (id = 1) for the whole Refer & Earn programme. Kept in the
/// database rather than env so the admin can tune payout rules without a deploy.
model PartnerProgramSetting {
  id Int @id @default(1)

  // ── Earning approval ──────────────────────────────────────────────────────
  /// Days an earning must age before it can be auto-approved. This is the
  /// refund window: money that comes back inside it never became payable.
  holdDays          Int     @default(7)
  /// Auto-approve earnings once the hold has passed. Off = every earning is
  /// approved by hand (the original behaviour).
  autoApproveEnabled Boolean @default(true)
  /// Earnings at or above this stay manual even when auto-approve is on.
  autoApproveMaxAmount Int   @default(5000)

  // ── Payouts ───────────────────────────────────────────────────────────────
  /// Balance below this carries forward instead of becoming a payout.
  minPayoutAmount   Int     @default(500)
  /// Day of the month payouts are run, shown to partners so "kab aayega" has an
  /// answer.
  payoutDayOfMonth  Int     @default(5)
  /// Second admin must approve a payout at or above this. 0 disables.
  makerCheckerAbove Int     @default(10000)

  // ── TDS (section 194H) ────────────────────────────────────────────────────
  tdsEnabled        Boolean @default(false)
  tdsRateWithPan    Int     @default(5)
  tdsRateWithoutPan Int     @default(20)
  /// TDS only starts once the partner's financial-year commission crosses this.
  tdsThresholdYearly Int    @default(15000)

  // ── Tiers ─────────────────────────────────────────────────────────────────
  /// Paid conversions needed for each tier, and the extra commission points
  /// each tier adds on top of the plan rate.
  goldAfterConversions     Int @default(10)
  platinumAfterConversions Int @default(50)
  goldBonusPercent         Int @default(2)
  platinumBonusPercent     Int @default(5)

  updatedAt DateTime @updatedAt
  updatedBy Int?

  @@map("partner_program_settings")
}

/// One row per referral-link open. This is what makes attribution survive the
/// gap between "owner clicked the link" and "owner finally registered", and it
/// is the only source of a real click → signup → paid funnel.
model ReferralClick {
  id        Int      @id @default(autoincrement())
  /// The raw code from the URL, kept even when it resolves to nothing so dead
  /// codes still circulating can be spotted.
  code      String   @db.VarChar(20)
  partnerId Int?
  /// Owner-to-owner referrals use the same pipe; this is the referring user.
  referrerUserId Int?
  landingPath String? @db.VarChar(300)
  ip          String? @db.VarChar(45)
  userAgent   String? @db.VarChar(300)
  utmSource   String? @db.VarChar(60)
  utmMedium   String? @db.VarChar(60)
  utmCampaign String? @db.VarChar(60)
  /// Set when this click's cookie actually produced a registration.
  convertedUserId Int?
  convertedAt     DateTime?
  createdAt       DateTime  @default(now())

  partner PartnerProfile? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([code, createdAt])
  @@index([partnerId, createdAt])
  @@index([convertedUserId])
  @@map("referral_clicks")
}

/// A partner's own pipeline, before an owner exists in the system. Without this
/// the portal can only show "registered" or nothing at all.
model PartnerLead {
  id        Int      @id @default(autoincrement())
  partnerId Int
  name      String   @db.VarChar(120)
  phone     String   @db.VarChar(15)
  city      String?  @db.VarChar(100)
  pgName    String?  @db.VarChar(150)
  /// NEW | CONTACTED | DEMO | NEGOTIATION | WON | LOST
  stage     String   @default("NEW") @db.VarChar(15)
  notes     String?
  nextFollowUpAt DateTime?
  /// Set when the lead becomes a real owner account.
  convertedUserId Int?
  convertedAt     DateTime?
  lostReason String?  @db.VarChar(200)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  partner PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, phone])
  @@index([partnerId, stage])
  @@index([nextFollowUpAt])
  @@map("partner_leads")
}

model PartnerSetting {
  id             Int      @id @default(autoincrement())
  partnerId      Int      @unique
  notifyInApp    Boolean  @default(true)
  notifyEmail    Boolean  @default(true)
  notifyWhatsapp Boolean  @default(false)
  theme          String   @default("SYSTEM") @db.VarChar(10)
  language       String   @default("ENGLISH") @db.VarChar(10)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  partner PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("partner_settings")
}

/// One row per commission-bearing event.
/// `amount` comes from the plan's rate (plus any partner override and tier
/// bonus); the admin can still adjust or cancel an individual row. A plan set to
/// commission type NONE still creates the row at ₹0 for the admin to price.
model PartnerEarning {
  id             Int           @id @default(autoincrement())
  partnerId      Int
  // Commission follows the OWNER, not the PG: one payment earns one commission
  // however many PGs that owner has. `ownerId` + `invoiceId` are the real anchor.
  ownerId        Int?
  invoiceId      Int?          @unique // the payment this commission was earned on
  // Legacy/reporting only — which PG the conversion related to. Nullable because
  // an owner-level commission isn't tied to any single PG.
  listingId      Int?
  subscriptionId Int? // which paid subscription triggered this
  // Negative for ADJUSTMENT rows — a refund clawback nets off the next payout.
  amount         Int           @default(0) // ₹, from the plan's commission %
  status         EarningStatus @default(PENDING)
  // What produced this row:
  //   REFERRAL   — the normal commission on an owner's payment
  //   OVERRIDE   — a parent partner's cut of a sub-partner's REFERRAL earning
  //   ADJUSTMENT — a clawback (negative) after a refund or chargeback
  kind            String  @default("REFERRAL") @db.VarChar(12)
  parentEarningId Int?
  // Snapshots: the admin can change plan pricing later, so the earning must
  // remember what the conversion was actually based on.
  planNameSnapshot  String?    @db.VarChar(50)
  planPriceSnapshot Int?
  // How the amount was arrived at, e.g. "20% + 2% Gold of ₹5,000". Every payout
  // dispute starts with "yeh amount kaise bana" — this answers it.
  commissionRateSnapshot String? @db.VarChar(60)
  // Hold: the earning exists and is visible, but must not be approved or paid
  // yet. Used for the refund window, flagged partners and suspended partners.
  onHold         Boolean       @default(false)
  holdReason     String?       @db.VarChar(200)
  /// When the refund window closes and auto-approval may consider this row.
  eligibleAt     DateTime?
  autoApproved   Boolean       @default(false)
  /// Maker-checker: whoever last set the amount cannot also approve it.
  amountSetBy    Int?
  payoutId       Int?
  approvedAt     DateTime?
  approvedBy     Int?
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  partner PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  owner   User?          @relation("EarningOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  listing Listing?       @relation(fields: [listingId], references: [id], onDelete: SetNull)
  invoice Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payout  PartnerPayout? @relation(fields: [payoutId], references: [id])
  // A REFERRAL earning can spawn at most one OVERRIDE and one ADJUSTMENT.
  parentEarning PartnerEarning?  @relation("EarningDerivation", fields: [parentEarningId], references: [id], onDelete: Cascade)
  derived       PartnerEarning[] @relation("EarningDerivation")

  // `invoiceId @unique` is the real guarantee: one payment can produce only one
  // commission, so a retry or double-click can never duplicate money. It replaces
  // the old @@unique([partnerId, listingId]), which capped a PG at ONE lifetime
  // earning and made recurring commission impossible.
  // A derived row exists at most once per source: one OVERRIDE and one
  // ADJUSTMENT per REFERRAL earning. This is what stops a refund processed
  // twice from clawing back twice, exactly as invoiceId does for the original.
  @@unique([parentEarningId, kind])
  @@index([partnerId, status])
  @@index([ownerId])
  @@index([listingId])
  @@index([createdAt])
  @@index([status, onHold, eligibleAt])
  @@map("partner_earnings")
}

/// A batch payment to a partner; approved earnings are attached to it.
model PartnerPayout {
  id        Int          @id @default(autoincrement())
  partnerId Int
  /// Net amount actually transferred. Kept as `amount` so every existing read
  /// still means the same thing: what the partner received.
  amount    Int
  method    String       @default("UPI") @db.VarChar(20)
  reference String?      @db.VarChar(60) // UTR / txn ref — required to complete
  // A payout starts PROCESSING and only becomes COMPLETED when a UTR is
  // recorded. The transfer happens outside the app, so claiming "paid" at
  // creation time made the system state a fact it could not know.
  status    PayoutStatus @default(PROCESSING)
  paidAt    DateTime?
  notes     String?
  createdBy Int?
  createdAt DateTime     @default(now())

  // ── TDS breakdown (section 194H) ──────────────────────────────────────────
  grossAmount Int @default(0)
  tdsRate     Int @default(0) // percent applied
  tdsAmount   Int @default(0)

  /// "2026-07" — which cycle this payout covers. With the unique key below it
  /// is what stops one partner being paid twice for the same month.
  periodLabel    String? @db.VarChar(10)
  idempotencyKey String? @unique @db.VarChar(90)
  proofUrl       String?

  // ── Reversal (a failed bank transfer) ─────────────────────────────────────
  // Earnings are terminal once PAID, so a failed transfer cannot be fixed by
  // editing. Reversing the payout is the only sanctioned route back.
  reversedAt    DateTime?
  reversedBy    Int?
  reverseReason String?   @db.VarChar(300)

  /// Maker-checker for large payouts.
  approvedBy Int?
  approvedAt DateTime?

  partner  PartnerProfile   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  earnings PartnerEarning[]

  @@index([partnerId, status])
  @@map("partner_payouts")
}

