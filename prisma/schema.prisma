  room_configurations   room_configurations @relation(fields: [roomConfigId], references: [id], onDelete: Cascade)
}

model room_configurations {
  id                  Int                @id @default(autoincrement())
  listingId           Int
  roomType            String             @db.VarChar(15)
  attachedWashroom    Boolean            @default(false)
  sharedWashroom      Boolean            @default(false)
  sharedWashroomRatio Int?
  isAC                Boolean            @default(false)
  hasBalcony          Boolean            @default(false)
  balconyFacing       String?            @db.VarChar(20)
  roomSizeSqFt        Int?
  bedType             String?            @db.VarChar(10)
  mattressType        String?            @db.VarChar(10)
  cupboardCount       Int                @default(0)
  hasStudyTable       Boolean            @default(false)
  hasChair            Boolean            @default(false)
  maxOccupancy        Int                @default(1)
  roomCount           Int                @default(1)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime
  room_availability   room_availability?
  listings            Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  room_pricing        room_pricing?

  @@index([listingId])
}

model room_pricing {
  id                   Int                 @id @default(autoincrement())
  roomConfigId         Int                 @unique
  rentPerBed           Int                 @default(0)
  depositPerBed        Int                 @default(0)
  maintenanceMonthly   Int?
  electricityType      String?             @db.VarChar(10)
  electricityRate      Int?
  waterCharges         Int?
  foodCharges          Int?
  laundryCharges       Int?
  cleaningCharges      Int?
  wifiCharges          Int?
  parkingCharges       Int?
  hiddenChargesNote    String?
  noHiddenCharges      Boolean             @default(false)
  earlyPaymentDiscount Int?
  longTermDiscount6m   Int?
  longTermDiscount12m  Int?
  introOfferAmount     Int?
  introOfferValidUntil DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime
  room_configurations  room_configurations @relation(fields: [roomConfigId], references: [id], onDelete: Cascade)
}

model trust_records {
  id               Int      @id @default(autoincrement())
  listingId        Int      @unique
  phoneVerified    Boolean  @default(false)
  whatsappVerified Boolean  @default(false)
  locationVerified Boolean  @default(false)
  photoVerified    Boolean  @default(false)
  kycDocUrl        String?
  kycDocType       String?  @db.VarChar(30)
  kycStatus        String   @default("NONE") @db.VarChar(15)
  qualityScore     Int      @default(0)
  trustScore       Int      @default(0)
  seoScore         Int      @default(0)
  lastCalculated   DateTime @default(now())
  listings         Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model SearchAnalytic {
  id        Int      @id @default(autoincrement())
  query     String?  @db.VarChar(255)
  citySlug  String?  @db.VarChar(120)
  createdAt DateTime @default(now())

  @@index([citySlug])
  @@index([createdAt])
  @@map("search_analytics")
}

