# Database (PostgreSQL — Neon or any Postgres instance)
DATABASE_URL=

# NextAuth v5 — generate with: openssl rand -base64 32
# (NEXTAUTH_SECRET also works as a fallback — some deployments still use the v4 name)
AUTH_SECRET=
AUTH_URL=

# Razorpay (payments)
# Test and live mode have DIFFERENT keys and a DIFFERENT webhook secret. Switching
# the app to live mode means replacing all four of these, not just the key id.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Signing secret for /api/payment/webhook — the server-to-server payment
# notification. Without it that route rejects everything (fail-closed), and a
# payment whose browser callback never lands is silently lost: money taken, no
# subscription, no partner commission.
#
# How to get it:
#   1. Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook
#   2. URL:    https://<your-domain>/api/payment/webhook
#   3. Event:  payment.captured   (tick only this one)
#   4. Type any string as the "Secret", save, and paste the SAME string below.
#      Razorpay does not generate it for you — you choose it.
#
# The URL must be publicly reachable; Razorpay's servers cannot call localhost.
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Fast2SMS (OTP delivery)
FAST2SMS_API_KEY=

# Resend (transactional email)
RESEND_API_KEY=
FROM_EMAIL=

# Google Maps — the listing/PG-registration map.
#
# Without these the map falls back to OpenStreetMap, which still works but
# cannot resolve a full Indian postal address: strings like
#   "2nd St, Mahaveer Nagar-II, ... Kota, Rajasthan 324005"
# return zero results from every free geocoder, so the pin lands on the middle
# of the PIN-code area and the owner has to drag it. Google resolves them.
#
# Setup (both values are the SAME key):
#   1. console.cloud.google.com -> create a project
#   2. Enable: Maps JavaScript API, Places API, Geocoding API
#   3. Billing must be enabled. Google gives a monthly free credit that covers
#      normal usage; past that it is charged per request.
#   4. APIs & Services -> Credentials -> Create API key
#   5. Restrict it: HTTP referrers = your domain, and only the three APIs above
#
# NEXT_PUBLIC_ is sent to the browser (unavoidable for the map SDK) — the
# referrer restriction in step 5 is what stops others using it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Google Indexing API (optional — pings Google when a listing goes live)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Upstash Redis (optional — enables OTP rate limiting; skipped if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public app URL (used for canonical links, sitemaps, indexing pings)
NEXT_PUBLIC_APP_URL=https://pgsathi.in

# NOTE: test-account logins used to be listed here. They were removed because this
# repository is public — those were real, working accounts on the live database.
# Ask the project owner for test credentials; never commit them.